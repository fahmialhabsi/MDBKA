import type { MarketData } from "../../types/analysis";
import { SUPPORTED_SYMBOLS, getInstrumentProfile, normalizeSymbol } from "../../lib/instrumentConfig";
import { parseInstrumentPrice } from "../../lib/priceParser";
import {
  normalizeOcrPriceToken,
  parseMarketWatchBidAsk,
} from "../../lib/marketWatchParser";
import { traceOcrStage, traceTag, truncateText } from "../../lib/debugTrace";

export interface OcrCandleContext {
  date?: string;
  time?: string;
}

export interface OcrDebugResult {
  selectedSymbol: string;
  detectedSymbols: string[];
  marketWatchCandidateLines: string[];
  chosenMarketWatchLine?: string;
  parsedBid?: number;
  parsedAsk?: number;
  parsedOpen?: number;
  parsedHigh?: number;
  parsedLow?: number;
  parsedClose?: number;
  parsedMa50?: number;
  parsedCci?: number;
  parsedRsi?: number;
  parsedAtr?: number;
  parsedMacd?: number;
  parsedSignal?: number;
  rejectedFields: string[];
  warnings: string[];
}

export interface OcrParseOptions {
  /** Simbol pilihan pengguna di form = sumber kebenaran. Wajib eksplisit. */
  activeSymbol: string;
  /** Teks crop region Market Watch (bila ada). MW hanya dibaca dari sini. */
  marketWatchText?: string;
  /** Teks crop region Data Window (bila ada). Sisanya dibaca dari sini. */
  dataWindowText?: string;
}

/**
 * Menggabungkan hasil OCR region menjadi satu teks (urutan MW lalu DW).
 * Murni dan teruji; region kosong diabaikan.
 */
export function combineRegionTexts(
  marketWatchText: string,
  dataWindowText: string
): string {
  return [marketWatchText.trim(), dataWindowText.trim()]
    .filter(Boolean)
    .join("\n");
}

export interface OcrMarketResult {
  data: Partial<MarketData>;
  warnings: string[];
  missingFields: string[];
  sourceLabels: Partial<Record<keyof MarketData, string>>;
  candle: OcrCandleContext;
  debug: OcrDebugResult;
}

const REQUIRED_OCR_FIELDS: Array<keyof MarketData> = [
  "bid",
  "ask",
  "close",
  "open",
  "high",
  "low",
  "ma50",
  "cci",
  "rsi",
  "macd",
  "macdSignal",
  "atr",
  "support",
  "resistance",
];

// Daftar kanonis tunggal dari instrumentConfig, ditambah alias yang hanya
// muncul di OCR (nama broker/lintas simbol). Jangan membuat daftar
// kanonis kedua di file ini.
const OCR_SYMBOLS: readonly string[] = [
  ...SUPPORTED_SYMBOLS,
  "NAS100",
  "NASDAQ",
  "USTEC",
  "USDCAD"
];

const TIMEFRAMES = [
  "M1",
  "M5",
  "M15",
  "M30",
  "H1",
  "H4",
  "D1",
  "W1",
  "MN1"
];

function normalizeText(text: string): string {
  return text
    .replace(/\r/g, "\n")
    .replace(/[|]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function findSymbol(text: string): string | null {
  const names = OCR_SYMBOLS.join("|");
  const chartMatch = text.match(
    new RegExp(
      `\\b(${names})\\s*[,/ ]\\s*(M1|M5|M15|M30|H1|H4|D1|W1|MN1)\\b`,
      "i"
    )
  );

  if (chartMatch) {
    const symbol = chartMatch[1].toUpperCase();

    if (symbol === "NASDAQ") return "NAS100";
    if (symbol === "USTEC") return "US100";

    return symbol;
  }

  for (const symbol of OCR_SYMBOLS) {
    if (
      new RegExp(`\\b${symbol}\\b`, "i").test(text)
    ) {
      if (symbol === "NASDAQ") return "NAS100";
      if (symbol === "USTEC") return "US100";
      return symbol;
    }
  }

  return null;
}

/**
 * Semua simbol yang muncul dalam teks OCR sesuai urutan kemunculan
 * (dinormalisasi; duplikat dibuang). Untuk debug dan audit, BUKAN
 * untuk memilih simbol aktif (simbol aktif datang dari form).
 */
export function findAllSymbols(text: string): string[] {
  const ordered = [...OCR_SYMBOLS].sort((a, b) => b.length - a.length);
  const pattern = new RegExp(`\\b(${ordered.join("|")})\\b`, "gi");
  const found: string[] = [];

  for (const match of text.matchAll(pattern)) {
    const normalized = normalizeSymbol(match[1].toUpperCase());
    if (normalized && !found.includes(normalized)) {
      found.push(normalized);
    }
  }

  return found;
}

function findTimeframe(
  text: string,
  fallback: string
): string {
  const found = TIMEFRAMES.find((timeframe) =>
    new RegExp(`\\b${timeframe}\\b`, "i").test(text)
  );

  return found ?? fallback;
}

function findLabeledRawNumber(
  text: string,
  labels: string[]
): string | null {
  for (const label of labels) {
    const regex = new RegExp(
      `${label}\\s*(?:\\([^)]*\\))?\\s*[:=]?\\s*(-?\\d+(?:[.,]\\d+)?)`,
      "i"
    );

    const match = text.match(regex);

    if (match?.[1]) {
      return match[1];
    }
  }

  return null;
}

function parsePriceLabel(
  text: string,
  labels: string[],
  symbol: string
): number | null {
  const raw = findLabeledRawNumber(text, labels);

  if (raw === null) return null;

  return parseInstrumentPrice(raw, symbol);
}

export interface SignedIndicatorResult {
  value: number | null;
  /** True bila tanda +/- terbaca eksplisit (menempel atau terpisah). */
  signExplicit: boolean;
}

function splitOcrLines(rawText: string): string[] {
  return rawText
    .replace(/\r/g, "\n")
    .split("\n")
    .map((line) => line.replace(/\s+/g, " ").trim())
    .filter(Boolean);
}

/**
 * True bila baris memuat label field lain (OHLC/indikator/waktu/harga).
 * Baris lookahead yang berlabel dilewati agar tidak mencuri nilainya.
 */
function hasOtherFieldLabel(line: string): boolean {
  return /\b(Signal|RSI|CCI|ATR|MACD|Moving Average|Open|High|Low|Close|Date|Time|Bid|Ask|Support|Resistance|Volume|Spread)\b/i.test(
    line
  );
}

/**
 * Parser indikator berbasis baris label (bukan first-match teks datar,
 * agar tidak mengambil angka sumbu chart). Mendukung tanda terpisah
 * ("-", "+") dan angka hingga 2 baris setelah label.
 */
export function parseSignedIndicatorLine(
  rawText: string,
  label: RegExp,
  range?: { min: number; max: number }
): SignedIndicatorResult {
  const inRange = (value: number): boolean =>
    range === undefined || (value >= range.min && value <= range.max);

  const lines = splitOcrLines(rawText);

  for (const line of lines) {
    const match = line.match(label);
    if (!match || match.index === undefined) continue;

    const pools: string[][] = [
      line.slice(match.index + match[0].length).split(" ").filter(Boolean),
    ];
    const lineIndex = lines.indexOf(line);
    for (let offset = 1; offset <= 2; offset++) {
      const near = lines[lineIndex + offset];
      if (!near || hasOtherFieldLabel(near)) continue;
      pools.push(near.split(" ").filter(Boolean));
    }

    for (const tokens of pools) {
      for (let i = 0; i < tokens.length; i++) {
        const token = tokens[i].replace(/[,;:%]$/, "").replace(/[–—]/g, "-");

        if ((token === "-" || token === "+") && i + 1 < tokens.length) {
          const next = tokens[i + 1].replace(/[,;:%]$/, "");
          const signed = normalizeOcrPriceToken(`${token === "+" ? "+" : "-"}${next}`);
          if (signed !== null && inRange(signed)) {
            return { value: signed, signExplicit: true };
          }
          continue;
        }

        const value = normalizeOcrPriceToken(token);
        if (value === null || !inRange(value)) continue;
        return { value, signExplicit: /^[-+]/.test(token) };
      }
    }
    // Lanjut ke baris label berikutnya (perilaku first-valid, dibatasi baris).
  }

  return { value: null, signExplicit: false };
}

/** Angka kedua pada baris MACD ("MACD(12,26,9) a b") sebagai Signal. */
function secondNumberOnMacdLine(rawText: string): number | null {
  for (const line of splitOcrLines(rawText)) {
    const match = line.match(/\bMACD\b/i);
    if (!match || match.index === undefined) continue;
    const numbers = line
      .slice(match.index + match[0].length)
      .split(" ")
      .filter(Boolean)
      .map((token) => normalizeOcrPriceToken(token.replace(/[,;:%]$/, "")))
      .filter((value): value is number => value !== null);
    if (numbers.length >= 2) return numbers[1];
  }
  return null;
}

function findQuote(
  text: string,
  symbol: string
): { bid: number; ask: number } | null {
  const regex = new RegExp(
    `${symbol}\\s+(-?\\d+(?:[.,]\\d+)?)\\s+(-?\\d+(?:[.,]\\d+)?)`,
    "i"
  );

  const match = text.match(regex);

  if (!match) return null;

  const bid = parseInstrumentPrice(match[1], symbol);
  const ask = parseInstrumentPrice(match[2], symbol);

  if (
    bid === null ||
    ask === null ||
    ask <= bid
  ) {
    return null;
  }

  return { bid, ask };
}

function parseOcrTextBase(
  rawText: string,
  symbol: string
): Partial<MarketData> {
  const text = normalizeText(rawText);
  const timeframe = findTimeframe(text, "");

  const result: Partial<MarketData> = { symbol };

  if (timeframe) result.timeframe = timeframe;

  const quote = findQuote(text, symbol);

  if (quote) {
    result.bid = quote.bid;
    result.ask = quote.ask;
  }

  const close = parsePriceLabel(
    text,
    ["Close", "\\bC\\b"],
    symbol
  );

  const open = parsePriceLabel(
    text,
    ["Open", "\\bO\\b"],
    symbol
  );

  const high = parsePriceLabel(
    text,
    ["High", "\\bH\\b"],
    symbol
  );

  const low = parsePriceLabel(
    text,
    ["Low", "\\bL\\b"],
    symbol
  );

  const ma50 = parsePriceLabel(
    text,
    ["MA\\s*\\(?50\\)?", "MA50", "MA 50", "Moving Average"],
    symbol
  );

  const support = parsePriceLabel(
    text,
    ["Support"],
    symbol
  );

  const resistance = parsePriceLabel(
    text,
    ["Resistance"],
    symbol
  );

  if (close !== null) result.close = close;
  if (open !== null) result.open = open;
  if (high !== null) result.high = high;
  if (low !== null) result.low = low;
  if (ma50 !== null) result.ma50 = ma50;
  if (support !== null) result.support = support;
  if (resistance !== null) result.resistance = resistance;

  return result;
}

/**
 * Parser MA(50) berbasis baris Data Window: angka harus berada pada baris
 * yang memuat label MA (bukan sumbu chart atau baris Bid/Ask) dan sesuai
 * skala simbol. Mengembalikan null + warning bila label ada tanpa angka.
 */
export function parseMaValue(
  rawText: string,
  symbol: string
): { value: number | null; warnings: string[] } {
  const profile = getInstrumentProfile(symbol);
  const lines = rawText
    .replace(/\r/g, "\n")
    .split("\n")
    .map((line) => line.replace(/\s+/g, " ").trim())
    .filter(Boolean);

  let labelSeen = false;
  let found: number | null = null;
  let labelLine = "";
  const lookaheadLines: string[] = [];
  const candidateTokens: string[] = [];
  let rejectionReason: string | null = null;

  for (const line of lines) {
    if (found !== null) break;
    const labelMatch = line.match(/MA\s*\(?\s*50\s*\)?|moving average/i);
    if (!labelMatch || labelMatch.index === undefined) continue;
    labelSeen = true;
    labelLine = line;

    const after = line.slice(labelMatch.index + labelMatch[0].length);
    const tokens = after.split(" ").filter(Boolean);
    candidateTokens.push(...tokens);

    for (const token of tokens) {
      const value = normalizeOcrPriceToken(token.replace(/[,;:%]$/, ""));
      if (value === null) continue;
      if (value >= profile.minPrice && value <= profile.maxPrice) {
        found = value;
        break;
      }
      rejectionReason = "out-of-scale";
    }

    if (found !== null) break;

    // Window terbatas: angka boleh berada maksimal 3 baris setelah label
    // (artefak OCR memisahkan label dan angka). Jangan lebih jauh agar
    // tidak mengambil angka sumbu chart.
    const lineIndex = lines.indexOf(line);
    for (let offset = 1; offset <= 3 && found === null; offset++) {
      const near = lines[lineIndex + offset];
      if (!near) continue;
      lookaheadLines.push(near);
      for (const token of near.split(" ").filter(Boolean)) {
        candidateTokens.push(token);
        const value = normalizeOcrPriceToken(token.replace(/[,;:%]$/, ""));
        if (value === null) continue;
        if (value >= profile.minPrice && value <= profile.maxPrice) {
          found = value;
          break;
        }
        rejectionReason = "out-of-scale";
      }
    }
  }

  // Fallback: label dan angka terpisah baris (artefak OCR).
  if (found === null && !labelSeen) {
    const flat = lines.join(" ");
    const fallback = parsePriceLabel(
      flat,
      ["MA\\s*\\(?50\\)?", "MA50", "MA 50", "Moving Average"],
      symbol
    );
    if (fallback !== null) found = fallback;
  }

  if (found === null && rejectionReason === null) {
    rejectionReason = labelSeen ? "no-valid-number" : "no-label";
  }

  traceTag("[MDBKA MA50]", {
    labelLine,
    lookaheadLines,
    candidateTokens: candidateTokens.slice(0, 12),
    selectedValue: found,
    rejectionReason: found !== null ? null : rejectionReason,
  });

  const warnings: string[] =
    found === null && labelSeen
      ? ["Label MA(50) ditemukan tetapi angka tidak jelas; MA50 dibiarkan kosong."]
      : [];

  traceOcrStage("ma-value", {
    activeSymbol: symbol,
    labelSeen,
    value: found,
    warnings,
  });

  return { value: found, warnings };
}

function findCandleContext(text: string): OcrCandleContext {  const candle: OcrCandleContext = {};

  const dateMatch = text.match(
    /(?:Date|Tanggal)\s*[:=]?\s*(\d{4}[.\-/]\d{1,2}[.\-/]\d{1,2}|\d{1,2}[.\-/]\d{1,2}[.\-/]\d{2,4})/i
  );
  if (dateMatch?.[1]) candle.date = dateMatch[1];

  const timeMatch = text.match(
    /(?:Time|Jam|Waktu)\s*[:=]?\s*(\d{1,2}:\d{2}(?::\d{2})?)/i
  );
  if (timeMatch?.[1]) candle.time = timeMatch[1];

  return candle;
}

/**
 * Versi kaya metadata dari parser OCR.
 *
 * Kontrak: simbol aktif WAJIB diberikan eksplisit via options (dari form
 * App.tsx = sumber kebenaran). Simbol hasil deteksi OCR hanya dipakai
 * bila form masih kosong, dan tidak pernah menimpa pilihan pengguna.
 */
export function parseOcrTextRich(
  rawText: string,
  options: OcrParseOptions
): OcrMarketResult {
  const flatText = normalizeText(rawText);
  const activeSymbol = normalizeSymbol(options.activeSymbol);
  const detectedSymbols = findAllSymbols(flatText);
  const fallbackSymbol = findSymbol(flatText) ?? detectedSymbols[0] ?? "";

  // Simbol untuk parsing & skala: pilihan form menang mutlak.
  const parseSymbol = activeSymbol || fallbackSymbol;

  // Region crop: Market Watch hanya dari teks region MW, sisanya
  // (OHLC/indikator/candle) hanya dari teks region Data Window.
  // Tanpa region, semuanya dibaca dari teks penuh (fallback).
  const mwText = options.marketWatchText ?? rawText;
  const dwText = options.dataWindowText ?? rawText;
  const data = parseOcrTextBase(dwText, parseSymbol);

  // data.symbol selalu diisi agar konsumen tahu simbol hasil parsing.
  if (activeSymbol) {
    data.symbol = activeSymbol;
  } else if (fallbackSymbol) {
    data.symbol = fallbackSymbol;
  } else {
    delete data.symbol;
  }

  const timeframe = data.timeframe ?? "";
  const warnings: string[] = [];
  const rejectedFields: string[] = [];
  const sourceLabels: Partial<Record<keyof MarketData, string>> = {};

  // MA(50) harus berasal dari baris labelnya (bukan sumbu chart).
  const maResult = parseMaValue(dwText, parseSymbol);
  if (maResult.value !== null) {
    data.ma50 = maResult.value;
  } else {
    delete data.ma50;
  }
  warnings.push(...maResult.warnings);

  // Indikator dibaca dari baris labelnya masing-masing (bukan first-match
  // teks datar yang bisa mengambil angka sumbu chart).
  const cciParsed = parseSignedIndicatorLine(dwText, /\bCCI\b/i);
  if (cciParsed.value !== null) {
    data.cci = cciParsed.value;
    if (cciParsed.value > 0 && !cciParsed.signExplicit) {
      warnings.push(
        "Tanda negatif CCI tidak terbaca. Periksa dan koreksi manual."
      );
    }
  }

  const rsiParsed = parseSignedIndicatorLine(dwText, /\bRSI\b/i, {
    min: 0,
    max: 100,
  });
  if (rsiParsed.value !== null) data.rsi = rsiParsed.value;

  const atrParsed = parseSignedIndicatorLine(dwText, /\bATR\b/i);
  if (atrParsed.value !== null) data.atr = atrParsed.value;

  const macdParsed = parseSignedIndicatorLine(dwText, /\bMACD\b/i);
  if (macdParsed.value !== null) data.macd = macdParsed.value;

  const signalParsed = parseSignedIndicatorLine(dwText, /\bSignal\b/i);
  const signalValue = signalParsed.value ?? secondNumberOnMacdLine(dwText);
  if (signalValue !== null) data.macdSignal = signalValue;

  // Indikator dibaca dari baris labelnya (bukan first-match teks datar
  // yang bisa mengambil angka sumbu chart). Tanda -/+ yang terpisah
  // dari angka tetap dikenali agar minus tidak hilang diam-diam.
  const cciParsed = parseSignedIndicatorLine(dwText, /\bCCI\b/i);
  if (cciParsed.value !== null) {
    data.cci = cciParsed.value;
    if (cciParsed.value > 0 && !cciParsed.signExplicit) {
      warnings.push(
        "Tanda negatif CCI tidak terbaca. Periksa dan koreksi manual."
      );
    }
  }

  const rsiParsed = parseSignedIndicatorLine(dwText, /\bRSI\b/i, {
    min: 0,
    max: 100,
  });
  if (rsiParsed.value !== null) data.rsi = rsiParsed.value;

  const atrParsed = parseSignedIndicatorLine(dwText, /\bATR\b/i);
  if (atrParsed.value !== null) data.atr = atrParsed.value;

  const macdParsed = parseSignedIndicatorLine(dwText, /\bMACD\b/i);
  if (macdParsed.value !== null) data.macd = macdParsed.value;

  const signalParsed = parseSignedIndicatorLine(dwText, /\bSignal\b/i);
  const signalValue = signalParsed.value ?? secondNumberOnMacdLine(dwText);
  if (signalValue !== null) data.macdSignal = signalValue;
  if (maResult.value === null && maResult.warnings.length > 0) {
    rejectedFields.push("ma50");
  }

  // Bid/Ask Market Watch menimpa hasil baris-simbol lama bila valid,
  // karena pencariannya berbasis baris dan terikat simbol aktif.
  const marketWatch = parseMarketWatchBidAsk(mwText, parseSymbol);

  if (marketWatch.bid !== null && marketWatch.ask !== null) {
    data.bid = marketWatch.bid;
    data.ask = marketWatch.ask;
    sourceLabels.bid = "Market Watch";
    sourceLabels.ask = "Market Watch";
    warnings.push(
      `Bid/Ask diambil dari baris Market Watch ${parseSymbol}. ` +
        "Periksa kembali karena harga dapat berubah setelah screenshot dibuat."
    );
  } else {
    warnings.push(...marketWatch.warnings);
    if (marketWatch.candidateLines.length > 0) {
      rejectedFields.push("bid", "ask");
    }
  }

  // RSI hanya valid 0-100; ATR harus > 0. CCI/MACD boleh negatif.
  if (data.rsi !== undefined && (data.rsi < 0 || data.rsi > 100)) {
    delete data.rsi;
    rejectedFields.push("rsi");
    warnings.push("RSI di luar rentang 0-100; RSI dibiarkan kosong.");
  }

  if (data.atr !== undefined && !(data.atr > 0)) {
    delete data.atr;
    rejectedFields.push("atr");
    warnings.push("ATR tidak valid; ATR dibiarkan kosong.");
  }

  const candle = findCandleContext(dwText.replace(/\r/g, "\n"));

  if (
    (candle.date || candle.time) &&
    marketWatch.bid !== null &&
    marketWatch.ask !== null
  ) {
    warnings.push(
      `Bid/Ask adalah harga saat screenshot; OHLC dan indikator berasal dari candle${timeframe ? ` ${timeframe}` : ""} yang dipilih.`
    );
  }

  const missingFields = REQUIRED_OCR_FIELDS.filter(
    (field) => data[field] === undefined
  );

  if (data.rsi === undefined) {
    warnings.push("RSI tidak ditemukan pada screenshot; RSI dibiarkan kosong.");
  }

  if (data.ma50 === undefined) {
    warnings.push("MA50 tidak ditemukan pada screenshot; MA50 dibiarkan kosong.");
  }

  const debug: OcrDebugResult = {
    selectedSymbol: activeSymbol,
    detectedSymbols,
    marketWatchCandidateLines: marketWatch.candidateLines,
    chosenMarketWatchLine: marketWatch.matchedLine,
    parsedBid: data.bid,
    parsedAsk: data.ask,
    parsedOpen: data.open,
    parsedHigh: data.high,
    parsedLow: data.low,
    parsedClose: data.close,
    parsedMa50: data.ma50,
    parsedCci: data.cci,
    parsedRsi: data.rsi,
    parsedAtr: data.atr,
    parsedMacd: data.macd,
    parsedSignal: data.macdSignal,
    rejectedFields,
    warnings: [...warnings],
  };

  traceOcrStage("parse-rich", {
    activeSymbol,
    detectedSymbols,
    rawText: truncateText(rawText),
    hasMarketWatchRegion: options.marketWatchText !== undefined,
    hasDataWindowRegion: options.dataWindowText !== undefined,
    marketWatchCandidateLines: debug.marketWatchCandidateLines,
    chosenMarketWatchLine: debug.chosenMarketWatchLine,
    marketWatchDebug: marketWatch.debug,
    ocrData: data,
    warnings,
    missingFields,
    rejectedFields,
  });

  return { data, warnings, missingFields, sourceLabels, candle, debug };
}

/** Kompatibilitas: perilaku lama mengembalikan data saja. */
export function parseOcrText(
  rawText: string,
  previous: MarketData
): Partial<MarketData> {
  const rich = parseOcrTextRich(rawText, { activeSymbol: previous.symbol });

  if (rich.data.timeframe === undefined && previous.timeframe) {
    rich.data.timeframe = previous.timeframe;
  }

  return rich.data;
}

# Konfigurasi aplikasi MDBKA
PORT=3000

# Tahap PROD: origin frontend untuk CORS backend (wajib bila akses via
# LAN/IP, mis. http://192.168.1.63:5173). Kosong = localhost:5173.
FRONTEND_ORIGIN=

# Tahap HIST-1: arsip tick JSONL harian untuk agregator masa depan.
# Direktori arsip (dibuat otomatis; JANGAN commit isinya).
HISTORY_DIR=./data/history
# Retensi file harian (hari). Lebih tua dihapus saat backend start.
HISTORY_RETENTION_DAYS=120
# Offset jam waktu server MT5 → UTC (untuk bucketing candle H1 nanti).
# Cek di MT5: jam Market Watch vs UTC. Umum +2/+3. Salah offset masih
# aman (ts_raw tersimpan, bisa bucketing ulang).
MT5_TZ_OFFSET_OTB=2
MT5_TZ_OFFSET_FINEX=3

# Tahap AP: posisi terbuka dari EA ExportPositions (ea/ExportPositions.mq5).
# Format kontrak: Ticket,Symbol,Type,Volume,PriceOpen,SL,TP,TimeOpen.
# Kosong → GET /api/positions menjawab 404 jujur (tanpa angka fiktif).
# Contoh: ...\Terminal\<ID>\MQL5\Files\positions.csv
POSITIONS_LOG_PATH=
POSITIONS_LOG_PATH_FINEX=

# Tahap PROD: base URL backend untuk frontend (Vite, dibaca saat build).
# Wajib bila backend tidak di localhost:3000. Contoh LAN:
# VITE_API_BASE_URL=http://192.168.1.63:3000
# Kosong = http://localhost:3000. Ganti .env lalu `npm run build` ulang.

# Tahap 5E-STEP2: path log MT5 (file .log/.csv atau direktori logs/).
# Contoh: C:\Users\NAMA\AppData\Roaming\MetaTrader 5\Tester\logs
# Bila dikosongkan, backend memakai default AppData\Roaming\MetaTrader 5
# dan menjawab 404 hingga log pertama terbaca (tanpa crash).
# Format equity dideteksi otomatis: baris "Key: value" (Balance:/Equity:)
# atau CSV ketat "Timestamp,Balance,Equity[,Profit[,TradeCount]]".
MT5_LOG_PATH=

# Tahap 5E-STEP3: path quotes.csv yang ditulis EA MT5
# (format kontrak: Timestamp,Symbol,Bid,Ask).
# Contoh: C:\Users\NAMA\AppData\Roaming\MetaQuotes\Terminal\<ID>\MQL5\Files\quotes.csv
# Bila dikosongkan, backend memakai default di bawah profil pengguna.
# PENTING: EA harus membuka file dengan shared-read (atau tulis via
# file sementara + rename atomic) agar backend dapat membaca snapshot
# yang konsisten; lock eksklusif membuat endpoint menjawab data kosong.
QUOTES_LOG_PATH=

# Dual-source Finex (opsional): pasang EA yang SAMA di terminal MT5
# Finex hingga menulis equity.csv + quotes.csv sendiri, lalu isi dua
# path di bawah dengan folder data Finex tersebut.
# Cara menemukan ID folder: buka MT5 Finex → File → Open Data Folder →
# catat segmen <ID> pada ...\Terminal\<ID>\MQL5\Files\.
# Bila dikosongkan → ?broker=finex menjawab 404 jujur (tanpa fallback
# diam ke sumber OTB, tanpa angka fiktif di UI).
MT5_LOG_PATH_FINEX=
QUOTES_LOG_PATH_FINEX=

# Jangan masukkan credential asli ke file ini
# Tambahkan konfigurasi API hanya pada file .env lokal

# Selisih jam server MT5 Finex terhadap UTC (default 1). Dipakai mencocokkan tanggal WIB untuk kurs KMK.
MT5_SERVER_UTC_OFFSET_HOURS=1
